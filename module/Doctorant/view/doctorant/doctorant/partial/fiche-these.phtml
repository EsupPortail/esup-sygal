<?php
/**
 * @see \Doctorant\Controller\DoctorantController::tableauDeBordAction()
 * @var These $these
 */

use Acteur\Entity\Db\ActeurThese;
use Acteur\Filter\ActeurThese\ActeursTheseFormatter;
use Application\Entity\Db\Role;
use Individu\Provider\Privilege\IndividuPrivileges;
use Individu\View\Helper\IndividuUsurpationHelper;
use These\Entity\Db\These;
use UnicaenPrivilege\Provider\Privilege\Privileges;

$acteursFormatter = new ActeursTheseFormatter();
$acteursFormatter->paramFilter(["role" => [
    Role::CODE_DIRECTEUR_THESE,
    Role::CODE_CODIRECTEUR_THESE,
]]);
$acteursFormatter->paramDisplay(["role" => true, "qualite" => true, "etablissement" => true, "uniteRecherche" => true]);
$acteursFormatter->asArray(true);
$acteursFormatted = $acteursFormatter->doFormat($these->getActeursSorted()->toArray());
?>

<div class="card-body">
    <div class="card mb-3">
        <div class="card-body">
            <div class="thesis-title d-flex align-items-start gap-2">
                <div>
                    <h5 class="card-title mb-1">Titre</h5>
                    <p class="card-text text-muted large fst-italic">
                        “<?php echo trim($these->getTitre()) ?>”
                    </p>
                    <?php if ($these->estConfidentielle()): ?>
                        <?php $content = sprintf('<span class="text-danger">Confidentielle jusqu\'au %s</span>', $these->getDateFinConfidentialiteToString()) ?>
                        <span class="text-danger"
                              data-bs-toggle="popover"
                              data-bs-content="<?php echo htmlspecialchars($content) ?>"
                              data-bs-trigger="hover"
                              data-bs-html="true"
                              data-bs-placement="bottom">
                            <span class="badge bg-danger">CONFIDENTIELLE</span>
                        </span>
                    <?php endif ?>
                </div>
            </div>
        </div>
    </div>

    <ul class="list-group list-group-flush">
        <li class="list-group-item">
            <strong>Discipline : </strong><?php echo $these->getDiscipline() ?>
        </li>

        <li class="list-group-item">
            <strong>Établissement d'inscription : </strong>
            <?php if ($these->getEtablissement()): ?>
                <?php echo $this->structure($these->getEtablissement(), true, false, [
                    "css" => "max-width:100%;
                    word-break:break-word; overflow-wrap:break-word;
                    white-space:normal;"
                ]); ?>
            <?php else: ?>
                <span class="badge bg-danger text-white" style="font-size:unset">
                    <span class="icon icon-warning" style="padding-right: unset"></span>
                    Aucun établissement n'est renseigné.
                </span>
            <?php endif; ?>
        </li>

        <li class="list-group-item">
            <strong>Unité de recherche :</strong>
            <?php if ($these->getUniteRecherche()): ?>
                <?php echo $this->structure($these->getUniteRecherche(), true, false, [
                    "css" => "max-width:100%;
                     word-break:break-word; overflow-wrap:break-word;
                     white-space:normal;"
                ]); ?>
            <?php else: ?>
                <span class="badge bg-warning text-white" style="font-size:unset">
                                    <span class="icon icon-warning" style="padding-right: unset"></span>
                                    <?php echo $this->translate("Aucune unité de recherche n'est renseignée") ?>
                                </span>
            <?php endif; ?>
        </li>
        <li class="list-group-item">
            <strong>École doctorale :</strong>
            <?php if ($these->getEcoleDoctorale()): ?>
                <?php echo $this->structure($these->getEcoleDoctorale(), true, false, [
                    "css" => "max-width:100%;
                    word-break:break-word; overflow-wrap:break-word;
                    white-space:normal;"
                ]); ?>
            <?php else: ?>
                <span class="badge bg-danger text-white" style="font-size:unset">
                    <span class="icon icon-warning" style="padding-right: unset"></span>
                    <?php echo $this->translate("Aucune école doctorale n'est renseignée") ?>
                </span>
            <?php endif ?>
        </li>
        <li class="list-group-item">
            <?php if ($acteursFormatted): ?>
                <?php
                foreach ($acteursFormatted as $role => $acteurs) { ?>
                    <dt><?php echo $role ?></dt>
                    <dd>
                        <table class="table table-extra-condensed">
                            <?php foreach ($acteurs as $i => $result){
                                /** @var ActeurThese $acteur */
                                $acteur = $result["acteur"]; ?>
                                <tr>
                                    <td>
                                        <?php
                                        $ligne = [];
                                        $canVisualiserIndividu = $this->isAllowed(Privileges::getResourceId(IndividuPrivileges::INDIVIDU_CONSULTER));
                                        if ($canVisualiserIndividu) {
                                            $identite = " <a href='".$this->url('individu/voir', ['individu' => $acteur->getIndividu()->getId()], [], true) ."'>" .
                                                "<span title='Accéder à la fiche détaillée de cet individu'>" . $result["nom"] . "</span></a>";
                                        } else {
                                            $identite = $result["nom"];
                                        }
                                        if ($acteur->getRole()->estUsurpable() && ! isset($result['alerte-supann-id'])) {
                                            // bouton d'usurpation d'identité
                                            $individuUsurpationHelper = $this->plugin('individuUsurpation');
                                            /* @var $individuUsurpationHelper IndividuUsurpationHelper */
                                            $individuUsurpationHelper->setIndividu($acteur->getIndividu());
                                            $identite .= $individuUsurpationHelper();
                                        }
                                        $ligne[] = $identite;
                                        if (isset($result["complement"])) {
                                            $ligne[] = "<strong>" . $result["complement"] . "</strong>";
                                        }
                                        if (isset($result["qualite"]) && trim($result["qualite"]) != "") {
                                            $ligne[] = $result["qualite"];
                                        }
                                        echo implode('<br>', $ligne);
                                        ?>
                                    </td>
                                    <td>
                                        <?php
                                        $ligne = [];
                                        if (isset($result["etablissementForce"]) && trim($result["etablissementForce"]) != "") {
                                            $ligne[] = sprintf("<span class='text-structure etablissement'><em data-bs-toggle='tooltip' data-bs-original-title='Valeur forcée (initialement : %s)'>%s</em></span>",
                                                $result["etablissement"] ?? 'vide',
                                                $result["etablissementForce"],
                                            );
                                        }
                                        elseif (isset($result["etablissement"]) && trim($result["etablissement"]) != "") {
                                            $ligne[] = "<span class='text-structure etablissement' style='background-color:white;padding: 4px 4px 5px 0;' data-bs-toggle='tooltip' data-placement='right' data-bs-original-title='Établissement'>" . $result["etablissement"] . "</span>";
                                        }

                                        if (isset($result["uniteRecherche"]) && trim($result["uniteRecherche"]) != "") {
                                            $ligne[] = "<span class='text-structure ur' style='background-color:white;padding: 4px 4px 5px 0;'  data-bs-toggle='tooltip' data-placement='right' data-bs-original-title='Unité de recherche'>" . $result["uniteRecherche"] . "</span>";
                                        }
                                        echo implode('<br>', $ligne);
                                        ?>
                                    </td>
                                </tr>
                            <?php } ?>
                        </table>
                    </dd>
                <?php } ?>
            <?php else : ?>
                <dd class="col-md-9">
                    <span class="badge bg-danger text-white" style="font-size:unset">
                        <span class="icon icon-warning" style="padding-right: unset"></span>
                        <?php echo $this->translate("Aucune direction renseignée") ?>
                    </span>
                </dd>
            <?php endif ?>
        </li>
    </ul>
</div>
<div class="card-footer">
    <a href="<?php echo $this->url('these/identite', ['these' => $these], [], true); ?>" class="btn btn-primary">
        <span class="icon icon-voir"></span>
        Accéder à la fiche détaillée
    </a>
</div>

<style>
    .thesis-title {
        border-left: 4px solid var(--primary-color);
        padding-left: 12px;
    }
</style>