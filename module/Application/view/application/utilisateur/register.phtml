                        <?= $this->formControlGroup($form->get('nomUsuel')) ?>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <?= $this->formControlGroup($form->get('prenom')) ?>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <?= $this->formControlGroup($form->get('email')) ?>
                    </div>
                </div>

