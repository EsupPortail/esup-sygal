<?php

use Application\Controller\UtilisateurController;

/**
 * @var \Application\Entity\Db\Utilisateur|null $utilisateur
 * @var \Laminas\Form\Form $form
 * @var \Application\View\Renderer\PhpRenderer $this
 *
 * @see UtilisateurController::registerAction()
 */

?>

<?php $this->headTitle($this->translate("Création d'un compte utilisateur local")) ?>

<div class="container mt-4" id="page-gestion-creation-compte">
    <h1 class="mb-4">
        <i class="fas fa-user-plus me-2"></i>
        <?= $this->translate("Création d'un compte utilisateur local"); ?>
    </h1>

    <?php if ($utilisateur !== null): ?>
        <div class="alert alert-success d-flex" role="alert">
            <div>
                <h4 class="alert-heading">Compte créé avec succès</h4>
                <p>
                    Votre compte utilisateur local <strong><?= $utilisateur->getUsername() ?></strong> a été créé avec succès.<br>
                    Un mail vous a été envoyé pour vous indiquer comment initialiser votre compte.
                </p>
            </div>
        </div>

        <a href="<?= $this->url('home') ?>" class="btn btn-primary mt-3">
            <i class="icon icon-retour"></i> Retourner à l'accueil
        </a>

    <?php else: ?>

        <?= $this->alertes()->addAlertesFromFlashMessenger(true)->renderAsBootstrapToasts() ?>
        <a href="<?= $this->url('zfcuser/login') ?>" class="btn btn-primary mb-3">
            <i class="icon icon-retour"></i> Retourner à la page de connexion
        </a>

        <div class="card register-card shadow-sm border-0 mb-4">
            <div class="card-body">
                <p class="mb-3 register-infos">
                    Cette page permet de vous créer un compte utilisateur local.<br>
                    <strong>Note :</strong> L'adresse électronique saisie sera votre identifiant de connexion.
                </p>

