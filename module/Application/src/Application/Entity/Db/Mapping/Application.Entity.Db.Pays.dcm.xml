<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Application\Entity\Db\Pays" table="PAYS" repository-class="Application\Entity\Db\Repository\PaysRepository">
    <id name="id" type="integer" column="id"/>

    <field name="codeIso" column="code_iso"/>
    <field name="codeIsoAlpha3" column="code_iso_alpha3"/>
    <field name="codeIsoAlpha2" column="code_iso_alpha2"/>
    <field name="libelle" column="libelle"/>
    <field name="libelleIso" column="libelle_iso"/>
    <field name="libelleNationalite" column="libelle_nationalite"/>
    <field name="codePaysApogee" column="code_pays_apogee" nullable="true"/>
  </entity>
</doctrine-mapping>
