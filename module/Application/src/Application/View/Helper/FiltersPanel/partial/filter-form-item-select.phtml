<?php

use Application\Search\Filter\SelectSearchFilter;
use Application\View\Renderer\PhpRenderer;

/**
 * @var PhpRenderer $this
 * @var SelectSearchFilter $filter
 * @var array $queryParams
 */

$attributes = $filter->getAttributes();
$isMultiple = $filter->multiple();

$classes =  array_map('trim', explode(' ', $attributes['class'] ?? ''));
$classes = array_merge($classes, ['filter', 'selectpicker', 'show-menu-arrow']);
$attributes['class'] = implode(' ', $classes);

$attributes['name'] = $isMultiple ? $filter->getName() . '[]' : $filter->getName();
$attributes['data-live-search'] = ($attributes['liveSearch'] ?? $attributes['live-search'] ?? false) ? 'true' : 'false';
$attributes['data-width'] = $attributes['width'] ?? 'fit';
$attributes['data-html'] = 'true';
if ($isMultiple) {
    $attributes['multiple'] = 'multiple';
}
?>

<select
    <?php foreach ($attributes as $key => $value): ?>
        <?php echo $key . '="' . $value . '"' ?>
    <?php endforeach; ?>
>

<?php foreach ($filter->getValueOptions() as $data): ?>

    <?php
    $value = $data['value'];
    $label = $data['label'];
    $subtext = $data['subtext'] ?? '';
    $class = $data['class'] ?? '';
    $isActive = $value === $filter->getValue() || $filter->isSelectValueOptionActive($value, $queryParams);
    ?>
    <option <?php echo $isActive ? 'selected' : '' ?>
            value="<?php echo $value ?>"
            class="<?php echo $class ?>"
            data-subtext="<?php echo $subtext ?>">
        <?php echo $label ?>
    </option>

<?php endforeach ?>

</select>