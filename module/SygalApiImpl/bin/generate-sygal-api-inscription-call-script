#!/usr/bin/env php
<?php

use JetBrains\PhpStorm\NoReturn;
use Laminas\Stdlib\Glob;

require_once __DIR__ . '/../../../vendor/autoload.php';

#[NoReturn] function usage(): void {
    echo "Génération des commandes curl d'envoi de fichiers JSON à l'API 'inscription-administrative'." . PHP_EOL . PHP_EOL;
    echo "Usage :" . PHP_EOL;
    echo "   HOST=<HOST> PORT=<PORT> USER=<USER> PASSWORD=<USER> VERSION=<VERSION> N=<N> php {$_SERVER['argv'][0]}" . PHP_EOL . PHP_EOL;
    echo "Avec <HOST> : host SyGAL, 'localhost' par défaut" . PHP_EOL;
    echo "     <PORT> : port à utiliser, obligatoire" . PHP_EOL;
    echo "     <USER> : user pour l'authentification, obligatoire" . PHP_EOL;
    echo "     <PASSWORD> : mot de passe pour l'authentification, obligatoire" . PHP_EOL;
    echo "     <VERSION> : version de l'API, 'v1' par défaut" . PHP_EOL;
    echo "     <N> : nombre de fichiers JSON à prendre en compte, 1 par défaut" . PHP_EOL . PHP_EOL;
    echo "Possibilité de rediriger la sortie standard pour créer un script." . PHP_EOL . PHP_EOL;
    exit(1);
}

$host = $_SERVER['HOST'] ?? 'localhost';
$port = $_SERVER['PORT'] ?? null;
$user = $_SERVER['USER'] ?? null;
$password = $_SERVER['PASSWORD'] ?? null;
$version = $_SERVER['VERSION'] ?? 'v1';
$n = $_SERVER['N'] ?? 1;

if ($port === null) {
    usage();
}
if ($user === null) {
    usage();
}
if ($password === null) {
    usage();
}

$sourceDataDirPath = '/tmp/api-data';
$outputScriptFileName = 'call-sygal-api-inscription.sh';

if (!file_exists($sourceDataDirPath)) {
    echo "Répertoire source introuvable : $sourceDataDirPath" . PHP_EOL;
    exit(1);
}

$argv = $_SERVER['argv'];
$jsonFileName = $argv[1] ?? null;

$filePaths = [];
if ($jsonFileName) {
    $dataFilePath = $sourceDataDirPath . '/' . $jsonFileName;
    if (!file_exists($dataFilePath)) {
        echo "Fichier JSON introuvable : $dataFilePath" . PHP_EOL;
        exit(1);
    }
    $filePaths[] = $dataFilePath;
} else {
    $dataFilePaths = Glob::glob($sourceDataDirPath . '/inscr-admin-*.json');
    $filePaths = array_slice($dataFilePaths, 0, $n);
    if (count($filePaths) < $n) {
        echo "Pas assez de fichiers JSON dans $sourceDataDirPath" . PHP_EOL;
        exit(1);
    }
}

exec(sprintf('echo -n "%s:%s" | base64', $user, $password), $out);
$token = trim(implode($out));

$cmdTemplate = <<<EOT
curl \
--no-progress-meter \
--insecure \
-H "Accept: application/json" \
-H "Content-Type: application/json" \
-H "Authorization: Basic $token" \
-X POST \
--data-binary "@%s" \
https://$host:$port/api/$version/inscription-administrative \
-b XDEBUG_SESSION=PHPSTORM
EOT;

$content = '';
foreach ($filePaths as $filePath) {
    //echo "$filePath" . PHP_EOL;
    $cmd = sprintf($cmdTemplate, $filePath);
    $content .= $cmd . PHP_EOL . PHP_EOL;
}

echo $content;
