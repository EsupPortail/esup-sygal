<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Formation\Entity\Db\Justificatif"
            table="formation_justificatif"
            repository-class="Formation\Entity\Db\Repository\JustificatifRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="SEQUENCE"/>
        </id>

        <many-to-one field="fichier" target-entity="Fichier\Entity\Db\Fichier">
            <join-column name="fichier_id" referenced-column-name="id"/>
        </many-to-one>
        <many-to-one field="inscription" target-entity="Formation\Entity\Db\Inscription">
            <join-column name="inscription_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <one-to-many field="justificatifSeances" target-entity="Formation\Entity\Db\JustificatifSeance" mapped-by="justificatif" />

        <!-- HISTORISATION ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
        <field name="histoCreation" type="datetime" column="histo_creation" nullable="false"/>
        <field name="histoDestruction" type="datetime" column="histo_destruction" nullable="true"/>
        <field name="histoModification" type="datetime" column="histo_modification" nullable="false"/>
        <many-to-one field="histoCreateur" target-entity="Application\Entity\Db\Utilisateur">
            <join-columns>
                <join-column name="histo_createur_id" referenced-column-name="id"/>
            </join-columns>
        </many-to-one>
        <many-to-one field="histoModificateur" target-entity="Application\Entity\Db\Utilisateur">
            <join-columns>
                <join-column name="histo_modificateur_id" referenced-column-name="id"/>
            </join-columns>
        </many-to-one>
        <many-to-one field="histoDestructeur" target-entity="Application\Entity\Db\Utilisateur">
            <join-columns>
                <join-column name="histo_destructeur_id" referenced-column-name="id"/>
            </join-columns>
        </many-to-one>
    </entity>
</doctrine-mapping>