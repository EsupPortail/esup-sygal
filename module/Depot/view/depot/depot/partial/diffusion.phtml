<?php
/**
 * @var These              $these
 * @var Diffusion          $diffusion
 * @var \Depot\Form\Diffusion\DiffusionTheseForm $form
 * @var boolean            $masquerFichiers
 * @var array              $theseFichiersExpurgesItems
 * @var array              $annexesFichiersExpurgesItems
 */

use Depot\Entity\Db\Diffusion;
use These\Entity\Db\These;

?>

<?php if ($diffusion->getConfidentielle() || $diffusion->getThese()->estConfidentielle()): ?>
<div class="row">
    <div class="col-6">
        <div class="alert alert-md alert-danger">
            <?php echo sprintf("La thèse est confidentielle jusqu'au %s.",
                $diffusion->getDateFinConfidentialiteToString() ?: $diffusion->getThese()->getDateFinConfidentialiteToString()) ?>
        </div>
    </div>
</div>
<?php endif ?>

<ul class="autorisation-diffusion">
    <li>
        <?php if ($diffusion->getDroitAuteurOk() === true): ?>
            <p>
                L'auteur garantit que tous les documents de la thèse sont libres de droits ou
                qu'il a acquis les droits afférents pour la reproduction et la représentation sur tous supports.
            </p>
        <?php elseif ($diffusion->getDroitAuteurOk() === false): ?>
            <p>
                L'auteur ne garantit pas que tous les documents de la thèse sont libres de droits ou
                qu'il a acquis les droits afférents pour la reproduction et la représentation sur tous supports. <br>
                À défaut, l'auteur fournit une version numérique spécifique excluant ces oeuvres tierces (version expurgée).
            </p>
        <?php endif ?>
    </li>

    <?php if (empty($masquerFichiers) && ! $diffusion->getDroitAuteurOk()): ?>
        <li>Version expurgée pour la diffusion :
        <?php echo $this->partial('depot/fichier-these/lister-fichiers', ['items' => $theseFichiersExpurgesItems]) ?></li>
        <li>Autres formats de fichiers expurgés, le cas échéant :
        <?php echo $this->partial('depot/fichier-these/lister-fichiers', ['items' => $annexesFichiersExpurgesItems]) ?></li>
    <?php endif ?>

    <li>
        <?php echo rtrim(rtrim($form->get('certifCharteDiff')->getLabel()), '.') ?>
        (téléchargeable en cliquant
        <a target="_blank"
           href="<?php echo $this->url('fichier/telecharger-permanent', ['idPermanent' => 'CHARTE_DEPOT_DIFFUSION_THESE']) ?>"
           download>ici</a>).
    </li>

    <li>
        <div>
            <?php echo $this->partial('depot/depot/partial/diffusion/autorisation_mel', ['diffusion' => $diffusion]) ?>
        </div>
        <div class="autorisation-laius text-info">
            <?php echo $this->partial('depot/depot/partial/diffusion/autorisation_mel_laius', ['diffusion' => $diffusion]) ?>
        </div>
    </li>

    <?php if ($diffusion->getAutorisPretPapier() !== null): ?>
        <li>
            <?php echo $this->partial('depot/depot/partial/diffusion/autorisation_mel_pret_papier', ['diffusion' => $diffusion]) ?>
        </li>
    <?php endif ?>

    <?php if ($orcid = $these->getDoctorant()->getIndividu()?->getOrcid()): ?>
        <li>Identifiant ORCID : <code class="text-muted"><?php echo $orcid ?></code></li>
    <?php endif ?>

    <?php if ($halId = $diffusion->getHalId()): ?>
        <li>IdHAL : <code class="text-muted"><?php echo $halId ?></code></li>
    <?php endif ?>
</ul>