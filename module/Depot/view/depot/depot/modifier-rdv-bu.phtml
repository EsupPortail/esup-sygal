<script src="/vendor/dragsort-1.3.2/dist/dragsort.js"></script>
<script src="/vendor/tagify-4.35.2/dist/tagify.js"></script>
<script src="/vendor/tagify-4.35.2/dist/tagify.polyfills.min.js"></script>
<link href="/vendor/dragsort-1.3.2/dist/dragsort.css" rel="stylesheet" type="text/css" />
<link href="/vendor/tagify-4.35.2/dist/tagify.css" rel="stylesheet" type="text/css" />
<script>
    $(function() {
        /**
         * Saisie des mots-clés comme des tags.
         * @see https://yaireo.github.io/tagify/
         */
        $('.taggable').each(function () {
            let tagify = new Tagify(this, {
                delimiters: '\\*', // séparateur : * (asterisque)
                originalInputValueFormat: valuesArr => valuesArr.map(item => item.value).join('*')
            });
            let dragsort = new DragSort(tagify.DOM.scope, {
                selector:'.' + tagify.settings.classNames.tag,
                callbacks: {
                    dragEnd: function(elm) {
                        tagify.updateValueByDOMTags()
                    }
                }
            });
        });
    });
</script>

<script>
    $(function () {
        $('[data-bs-toggle="tooltip"]').tooltip({});
    });
</script>