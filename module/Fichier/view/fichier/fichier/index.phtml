            <a href="<?php echo $s = $this->sortable('nature'); ?>"><?php echo $this->translate("Nature"); ?></a>
            <?php echo $s->icon() ?>
        </th>
        <th>
            <a href="<?php echo $s = $this->sortable('version'); ?>"><?php echo $this->translate("Version"); ?></a>
            <?php echo $s->icon() ?>
        </th>
        <th>
            <a href="<?php echo $s = $this->sortable('f.nomOriginal'); ?>"><?php echo $this->translate("Nom original"); ?></a>
