<?xml version="1.0" encoding="UTF-8"?>

<phpunit bootstrap="./vendor/autoload.php" colors="true" cacheDirectory="/tmp">

    <testsuites>
        <testsuite name="Application">
            <directory>./module/Application/tests</directory>
        </testsuite>
        <testsuite name="Retraitement">
            <directory>./module/Retraitement/test</directory>
        </testsuite>
        <testsuite name="Import">
            <directory>./module/Import/tests</directory>
        </testsuite>
        <testsuite name="Rule">
            <directory>./module/Application/tests/ApplicationUnitTest/Rule</directory>
        </testsuite>
<!--        <testsuite name="SygalApi">-->
<!--            <directory>./module/SygalApiImpl/tests/SygalApiTest/Functional</directory>-->
<!--        </testsuite>-->
        <testsuite name="SygalApiImpl">
            <directory>./module/SygalApiImpl/tests/SygalApiImplTest/V1</directory>
        </testsuite>
        <testsuite name="InscriptionAdministrative">
            <directory>./module/InscriptionAdministrative/tests/InscriptionAdministrativeTest</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./module/Application</directory>
            <directory suffix=".php">./module/Retraitement</directory>
            <directory suffix=".php">./module/Import</directory>
            <directory suffix=".php">./module/SygalApiImpl</directory>
            <directory suffix=".php">./module/InscriptionAdministrative</directory>
        </include>
    </source>

    <coverage includeUncoveredFiles="true"
              pathCoverage="false"
              ignoreDeprecatedCodeUnits="true"
              disableCodeCoverageIgnore="true">
        <report>
            <html outputDirectory="./tmp/coverage" lowUpperBound="50" highLowerBound="90"/>
        </report>
    </coverage>

</phpunit>